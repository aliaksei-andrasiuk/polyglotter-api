// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

enum Environment {
    dev
    prod
}

enum LanguageCode {
    pl
    en
}

enum DifficultyLevel {
    BASIC
    INTERMEDIATE
    ADVANCED
}

//
// Текущая плоская таблица для существующего словаря PL -> EN.
// Оставляем как источник данных для миграции.
//
model PhraseMapping {
    phraseId     String  @id
    wordId       String
    sourceRoot   String
    sourcePrefix String  @default("")
    sourceWord   String
    targetPhrase String
    wordsCount   Int     @db.SmallInt

    @@index([sourceWord])
    @@index([sourceWord, sourcePrefix])
    @@index([wordId])
}

model Language {
    id          Int                @id @default(autoincrement())
    code        String             @unique
    name        String

    bundlesFrom DictionaryBundle[] @relation("SourceLanguageBundles")
    bundlesTo   DictionaryBundle[] @relation("TargetLanguageBundles")

    lemmas      Lemma[]
    phrases     Phrase[]

    // Обратные связи для PhrasePattern
    sourcePatterns PhrasePattern[] @relation("SourcePatternLanguage")
    targetPatterns PhrasePattern[] @relation("TargetPatternLanguage")
}
//
// Лемма — базовая форма слова ("dom", "increase").
//
model Lemma {
    id               Int              @id @default(autoincrement())
    languageId       Int
    text             String
    pos              String?
    frequency        Float?
    difficulty       DifficultyLevel?

    language         Language         @relation(fields: [languageId], references: [id])

    translationsFrom Translation[]    @relation("SourceLemmaTranslations")
    translationsTo   Translation[]    @relation("TargetLemmaTranslations")

    wordForms        WordForm[]

    // Обратные связи для PhrasePattern
    patternsAsSource PhrasePattern[]  @relation("PhrasePatternSourceLemma")
    patternsAsTarget PhrasePattern[]  @relation("PhrasePatternTargetLemma")

    @@unique([languageId, text])
    @@index([languageId, text])
}

//
// Конкретная словоформа ("domu", "domem", "increasing" и т.п.).
// Можно заполнить позже, если будешь лемматизировать.
//
model WordForm {
    id       Int     @id @default(autoincrement())
    lemmaId  Int
    form     String
    morphTag String?

    lemma    Lemma   @relation(fields: [lemmaId], references: [id])

    @@unique([lemmaId, form])
    @@index([lemmaId])
    @@index([form])
}

//
// Фразы: идиомы, фразовые глаголы, устойчивые выражения.
// В твоём случае часть данных из PhraseMapping с wordsCount > 1
// как раз сюда и поедет.
//
model Phrase {
    id               Int              @id @default(autoincrement())
    languageId       Int
    text             String
    type             String?
    frequency        Float?
    difficulty       DifficultyLevel?

    language         Language         @relation(fields: [languageId], references: [id])

    translationsFrom Translation[]    @relation("SourcePhraseTranslations")
    translationsTo   Translation[]    @relation("TargetPhraseTranslations")

    // Обратные связи для PhrasePattern
    patternsAsSource PhrasePattern[]  @relation("PhrasePatternSourcePhrase")
    patternsAsTarget PhrasePattern[]  @relation("PhrasePatternTargetPhrase")

    @@unique([languageId, text])
    @@index([languageId, text])
}

//
// Переводы между lemma/phrase.
// Примеры:
//  - sourceLemmaId (pl "dom") -> targetLemmaId (en "house")
//  - sourcePhraseId (pl "wsiąść do pociągu") -> targetPhraseId (en "get on a train")
//  - смешанные варианты lemma <-> phrase тоже возможны.
//
model Translation {
    id             Int     @id @default(autoincrement())

    sourceLemmaId  Int?
    sourcePhraseId Int?
    targetLemmaId  Int?
    targetPhraseId Int?

    confidence     Float?
    senseKey       String?
    isPreferred    Boolean @default(false)

    sourceLemma    Lemma?  @relation("SourceLemmaTranslations", fields: [sourceLemmaId], references: [id])
    sourcePhrase   Phrase? @relation("SourcePhraseTranslations", fields: [sourcePhraseId], references: [id])
    targetLemma    Lemma?  @relation("TargetLemmaTranslations", fields: [targetLemmaId], references: [id])
    targetPhrase   Phrase? @relation("TargetPhraseTranslations", fields: [targetPhraseId], references: [id])

    @@index([sourceLemmaId])
    @@index([sourcePhraseId])
    @@index([targetLemmaId])
    @@index([targetPhraseId])
}

//
// Метаданные словарных бандлов для расширения (Tukan-style).
// Реально можно начать использовать позже, когда дойдём до генерации бандлов.
//
/**
 * Each record represents one versioned gzipped dictionary bundle on disk,
 * for a specific language pair and environment.
 *
 * Files on disk:
 *  - bundle-<version>.json.gz   (versioned)
 *  - LatestJSON.gz             (symlink/copy pointing to latest)
 */
model DictionaryBundle {
    id               Int         @id @default(autoincrement())

    env              Environment

    sourceLanguageId Int
    targetLanguageId Int

    /**
     * Version identifier for this bundle.
     * Recommended format: ISO timestamp like 2025-11-24T00-15-03Z
     */
    version          String

    /**
     * Name of the versioned gzip file on disk, e.g.
     * bundle-2025-11-24T00-15-03Z.json.gz
     */
    fileName         String

    /**
     * SHA256 of the gzip file. Used for ETag and integrity checks.
     */
    sha256           String      @db.VarChar(64)

    /**
     * Size of gzip in bytes (Content-Length).
     */
    sizeBytes        Int

    /**
     * Number of dictionary entries inside the bundle.
     */
    entriesCount     Int

    /**
     * Exactly one bundle per (env, sourceLanguageId, targetLanguageId)
     * should have isLatest=true. DB-level guarantee added via partial index.
     */
    isLatest         Boolean     @default(false)

    createdAt        DateTime    @default(now())

    sourceLanguage   Language    @relation("SourceLanguageBundles", fields: [sourceLanguageId], references: [id])
    targetLanguage   Language    @relation("TargetLanguageBundles", fields: [targetLanguageId], references: [id])

    // Unique versions per pair+env
    @@unique([env, sourceLanguageId, targetLanguageId, version])

    // Fast latest lookup
    @@index([env, sourceLanguageId, targetLanguageId, isLatest])
}

model PhrasePattern {
    id               Int      @id @default(autoincrement())

    // Пара языков
    sourceLanguageId Int
    targetLanguageId Int

    sourceLanguage   Language @relation("SourcePatternLanguage", fields: [sourceLanguageId], references: [id])
    targetLanguage   Language @relation("TargetPatternLanguage", fields: [targetLanguageId], references: [id])

    // Ссылки на нормализованные сущности
    sourcePhraseId   Int?
    targetPhraseId   Int?

    sourcePhrase     Phrase?  @relation("PhrasePatternSourcePhrase", fields: [sourcePhraseId], references: [id])
    targetPhrase     Phrase?  @relation("PhrasePatternTargetPhrase", fields: [targetPhraseId], references: [id])

    sourceLemmaId    Int?
    targetLemmaId    Int?

    sourceLemma      Lemma?   @relation("PhrasePatternSourceLemma", fields: [sourceLemmaId], references: [id])
    targetLemma      Lemma?   @relation("PhrasePatternTargetLemma", fields: [targetLemmaId], references: [id])

    // Runtime-ключи
    anchorText       String   // то, что матчим в тексте (sourceWord)
    prefixText       String?  // левый контекст (sourcePrefix)
    anchorIndex      Int?     // позиция anchor в sourcePhrase (для быстрых проверок)

    // Быстрый lookup по anchor
    @@index([sourceLanguageId, anchorText])

    @@unique([sourceLanguageId, targetLanguageId, anchorText, prefixText, sourcePhraseId, sourceLemmaId, targetPhraseId, targetLemmaId])
}
